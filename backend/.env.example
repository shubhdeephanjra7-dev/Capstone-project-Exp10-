# Copy to .env (never commit it). Any of these can also be supplied as real environment variables.
DB_URL=jdbc:mysql://localhost:3306/skillmate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=skillmate_user
DB_PASSWORD=ChooseYourOwnDatabasePassword123!

JWT_SECRET=SkillMate_Local_Dev_Secret_Change_This_2026_123456789
JWT_EXPIRATION_MINUTES=120

# Cross-site deploys (frontend on Vercel, backend on Render): secure=true and same-site=None are required
# so the HttpOnly auth cookie is sent on cross-origin requests. For local dev use secure=false and same-site=Lax.
COOKIE_SECURE=true
COOKIE_SAME_SITE=None

# Comma-separated list of allowed frontend origins (scheme + host, no trailing slash).
CORS_ALLOWED_ORIGINS=https://frontend-omega-six-43.vercel.app,http://localhost:5173

SKILLMATE_ADMIN_EMAIL=admin@example.com
SKILLMATE_ADMIN_PASSWORD=ChooseYourOwnAdminPassword123!
SKILLMATE_ADMIN_NAME=Administrator
